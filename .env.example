# Risk gate API server
PORT=8787
HOST=127.0.0.1

# KeeperHub remediation (Phase 2 - wired)
# Get an org-level API key at https://app.keeperhub.com/settings/api-keys
KEEPERHUB_API_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=

# Discord notification channel (Phase 2 - optional)
# Discord webhook URL for the `discord` notify channel
NOTIFY_DISCORD_WEBHOOK=

# 0G Storage anchor (Phase 6 - wired)
# Fund the wallet at https://faucet.0g.ai (0.1 0G/wallet/day) before first use.
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_PRIVATE_KEY=

# 0G Compute / Inference (stretch - not yet wired)
# Provider address is discovered at runtime via `broker.inference.listService()`.
ZERO_G_INFERENCE_PROVIDER=

# Gensyn AXL local node - decision gossip transport
# When set, every BLOCK decision is published to the local AXL bridge so
# co-operating ChainShield gates on other machines can react over the mesh.
# Falls back to a no-op when unset, so the risk gate works standalone.
AXL_BASE_URL=http://127.0.0.1:9002
