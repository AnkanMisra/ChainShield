{
  "name": "chainshield-agent",
  "version": "0.1.0",
  "private": true,
  "description": "ChainShield Agent — autonomous treasury and wallet protection.",
  "type": "module",
  "module": "src/risk-gate/server.ts",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "bun build ./src/risk-gate/server.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "dev": "bun run --watch src/risk-gate/server.ts",
    "demo": "bun run src/cli/demo.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
