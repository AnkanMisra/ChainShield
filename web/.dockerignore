# Things that must NOT be sent to the docker daemon for the web/ build context.

# Dev artefacts
node_modules
dist
.astro

# Editor / OS junk
.vscode
.DS_Store
*.swp
*.log

# Local env (the frontend is fully static — no env at runtime)
.env
.env.*
!.env.example

# Don't ship docs into the runtime image
README.md
