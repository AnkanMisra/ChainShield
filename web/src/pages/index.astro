---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import PolicySection from "../components/PolicySection.astro";
import EvaluateSection from "../components/EvaluateSection.astro";
import TimelineSection from "../components/TimelineSection.astro";
import JsonModal from "../components/JsonModal.astro";
---

<Layout>
  <Masthead />
  <main class="shell">
    <Hero />
    <PolicySection />
    <EvaluateSection />
    <TimelineSection />
  </main>
  <footer class="legal">
    <span>ChainShield Agent</span>
    <a
      class="legal-link"
      href="https://github.com/AnkanMisra/ChainShield"
      target="_blank"
      rel="noopener noreferrer"
    >View source</a>
  </footer>
  <JsonModal />
</Layout>

<script>
  import "../scripts/main.ts";
</script>
